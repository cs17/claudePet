# Shell scripts must keep LF even when checked out on Windows: a CRLF
# interpreter line makes bash fail with "bad interpreter", and CRLF inside a
# script breaks [[ ]] tests and heredocs in ways that are hard to spot.
*.sh            text eol=lf
*.js            text eol=lf
*.ts            text eol=lf
*.py            text eol=lf
*.md            text eol=lf
*.cmd           text eol=crlf
.gitattributes  text eol=lf

*.png           binary
